# Copy to .env and change the password. Docker Compose reads this automatically.
POSTGRES_USER=diabetes_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=diabetes_db
# Host port for the database (change if 5432 is already used on your machine)
DB_PORT=5432

# Only needed when running Python OUTSIDE Docker:
# DATABASE_URL=postgresql+psycopg2://diabetes_user:change_me@localhost:5432/diabetes_db
